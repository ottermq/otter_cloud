# otter's settings, with their defaults. Copy to .env for development and load
# it into your shell: set -a; . ./.env; set +a
# otter reads only the environment; it does not read .env itself.
#
# Secrets are never set here. A *_FILE variable names a file that only its
# owner can read (chmod 0400); otter refuses one readable by group or others.

# Every subcommand.
#OTTER_LOG_LEVEL=info                  # debug, info, warn, error

# api, worker, admin, migrate. Each process connects as its own role, so the
# URL names a user and no password.
OTTER_DATABASE_URL=postgres://otter_api@127.0.0.1:5432/otter?sslmode=disable
#OTTER_DATABASE_PASSWORD_FILE=/usr/local/etc/otter/db-password

# worker only. The token is root-equivalent on the node: a 0400 file owned
# by the worker's user, never copied to another machine.
#OTTER_JAILDECK_SOCKET=/var/run/jaildeck.sock
#OTTER_JAILDECK_TOKEN_FILE=/usr/local/etc/otter/jaildeck-token

# api only.
#OTTER_LISTEN_ADDR=127.0.0.1:8080
# Internal listener for Prometheus' /metrics; never the public one. "off"
# disables it.
#OTTER_METRICS_ADDR=127.0.0.1:9101
# Addresses or CIDR prefixes of the reverse proxy (the edge), whose
# X-Forwarded-For is believed for rate limits and session records.
#OTTER_TRUSTED_PROXIES=
# The origin customers use. https:// except on localhost.
OTTER_PUBLIC_URL=http://localhost:8080
