#!/bin/sh
# otter-platform-db-bootstrap: sets up the platform database in its own
# jail, otter-db, for the minimum profile (architecture.md §2, #58):
#
#   - TLS 1.3 only, with the server's own self-signed certificate, which
#     its clients pin (sslmode=verify-full, sslrootcert); its subject names
#     the jail's address;
#   - SCRAM passwords, and each role only from where its process runs:
#     otter_api from the otter-api jail; otter_migrator, otter_admin and
#     every node's worker role (members of otter_worker) from the node host;
#   - the roles and the database of bootstrap.sql.
#
#   otter-platform-db-bootstrap -l <jail-ip> -a <api-jail-ip>/32 -n <node-host>/32
#                               [-N cn] [-b shared_buffers] [-m max_connections]
#                               [-s bootstrap.sql]
#
# Run as root in the otter-db jail. Every argument is non-secret: it sets no
# password. The passwords are set afterwards from the node host, by
# deploy/control-plane/otter-db-password, which writes each one straight to
# the file of the process that uses it. Running it again changes nothing
# that is already right.
set -eu

PG_MAJOR=${PG_MAJOR:-18}
PGDATA=${PGDATA:-/var/db/postgres/data$PG_MAJOR}
ETC=${OTTER_PG_ETC:-/usr/local/etc}

listen= api= node_host= cn=$(hostname) buffers=256MB conns=50 sqlfile=$ETC/otter/bootstrap.sql
usage() {
	echo "usage: otter-platform-db-bootstrap -l <jail-ip> -a <api-jail-ip>/32 -n <node-host>/32 [-N cn] [-b shared_buffers] [-m max_connections] [-s bootstrap.sql]" >&2
	exit 2
}
while getopts l:a:n:N:b:m:s: opt; do
	case $opt in
	l) listen=$OPTARG ;;
	a) api=$OPTARG ;;
	n) node_host=$OPTARG ;;
	N) cn=$OPTARG ;;
	b) buffers=$OPTARG ;;
	m) conns=$OPTARG ;;
	s) sqlfile=$OPTARG ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# = 0 ] && [ -n "$listen" ] && [ -n "$api" ] && [ -n "$node_host" ] || usage
[ -f "$sqlfile" ] || {
	echo "otter-platform-db-bootstrap: no bootstrap.sql at $sqlfile" >&2
	exit 1
}

freebsd() { [ "$(uname -s)" = FreeBSD ]; }
root() { [ "$(id -u)" = 0 ]; }
say() { echo "otter-platform-db-bootstrap: $*"; }

# as_postgres runs a command as the postgres user, from a directory it can
# read.
as_postgres() {
	if [ "$(id -un)" = postgres ]; then
		(cd / && "$@")
	else
		cmd=
		for a in "$@"; do
			cmd="$cmd '$(printf %s "$a" | sed "s/'/'\\\\''/g")'"
		done
		(cd / && su -m postgres -c "$cmd")
	fi
}

if [ ! -f "$PGDATA/PG_VERSION" ]; then
	root && chown postgres:postgres "$(dirname "$PGDATA")"
	say "initdb $PGDATA"
	as_postgres initdb -D "$PGDATA" -U postgres --auth-local=peer --auth-host=reject \
		-E UTF8 --locale=C.UTF-8 >/dev/null
fi

# The server's own certificate. Its clients pin it, so no CA signs it; its
# subject names the address they dial, for verify-full. Replacing it means
# copying the new one to each client.
if [ ! -f "$PGDATA/server.key" ]; then
	say "certificate CN=$cn, IP:$listen"
	as_postgres openssl req -x509 -new -nodes -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
		-days 3650 -subj "/CN=$cn" -addext "subjectAltName=IP:$listen" \
		-keyout "$PGDATA/server.key" -out "$PGDATA/server.crt" 2>/dev/null
	as_postgres chmod 0600 "$PGDATA/server.key"
fi

as_postgres sh -c "cat > '$PGDATA/otter.conf'" <<CONF
# Written by otter-platform-db-bootstrap; edits are overwritten.
listen_addresses = '127.0.0.1, $listen'
ssl = on
ssl_cert_file = 'server.crt'
ssl_key_file = 'server.key'
ssl_min_protocol_version = 'TLSv1.3'
password_encryption = 'scram-sha-256'
shared_buffers = $buffers
max_connections = $conns
CONF
grep -q "^include_if_exists = 'otter.conf'" "$PGDATA/postgresql.conf" ||
	as_postgres sh -c "echo \"include_if_exists = 'otter.conf'\" >> '$PGDATA/postgresql.conf'"

as_postgres sh -c "cat > '$PGDATA/pg_hba.conf'" <<HBA
# Written by otter-platform-db-bootstrap; edits are overwritten.
local   all    all                          peer
hostssl otter  otter_api       $api   scram-sha-256
hostssl otter  otter_migrator  $node_host   scram-sha-256
hostssl otter  otter_admin     $node_host   scram-sha-256
hostssl otter  +otter_worker   $node_host   scram-sha-256
host    all    all             0.0.0.0/0    reject
HBA

if freebsd && root; then
	sysrc -q postgresql_enable=YES postgresql_data="$PGDATA" >/dev/null
	if service postgresql status >/dev/null 2>&1; then
		service postgresql reload >/dev/null
	else
		service postgresql start >/dev/null
	fi
fi

say "roles and database"
as_postgres psql -X -q -v ON_ERROR_STOP=1 -d postgres -f "$sqlfile" >/dev/null
