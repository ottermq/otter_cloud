# otter backup's settings for the platform DB's dumps (#118), read by
# 610.otter-platform-push. Install as
# /usr/local/etc/otter/backup-platform.env, mode 0600, root:wheel. No
# secrets here: the credentials are in their own 0400 file.

# s3: one bucket (and prefix) for the control plane, its own key. The
# copies go under platform/ in it.
OTTER_BACKUP_TARGET=s3
OTTER_BACKUP_S3_URL=https://<endpoint>/<bucket>/control-plane
# Some services want a region of their own ("auto"); the default is us-east-1.
#OTTER_BACKUP_S3_REGION=us-east-1
# One line, <access key id>:<secret access key>; mode 0400, root.
OTTER_BACKUP_S3_CREDENTIALS_FILE=/usr/local/etc/otter/backup-platform-s3
# age recipients (public keys), one a line. The private key is never on this
# machine (security.md, Secrets).
OTTER_BACKUP_RECIPIENTS_FILE=/usr/local/etc/otter/backup-recipients
# A copy that would take the copies past this isn't made: under a provider's
# free allowance, it can't run up a bill. K, M or G.
OTTER_BACKUP_MAX_BYTES=1G
