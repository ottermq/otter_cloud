# otter api's settings in the otter-api jail: paths and addresses, no secrets.
# Install as /usr/local/etc/otter/api.env, mode 0640, root:otter.
# rc.d reads it as shell assignments, KEY=value, one per line: quote a
# value that holds &, ;, spaces or <>.

# The platform DB in the otter-db jail, its certificate pinned: verify-full
# checks that it is that certificate, for that address.
OTTER_DATABASE_URL='postgres://otter_api@10.64.1.10:5432/otter?sslmode=verify-full&sslrootcert=/usr/local/etc/otter/platform-db.crt'
OTTER_DATABASE_PASSWORD_FILE=/usr/local/etc/otter/db-password

# On the jail's own address: PF lets the node host and, with #22, the edge
# reach it, and nothing else.
OTTER_LISTEN_ADDR=10.64.1.20:8080
OTTER_METRICS_ADDR=127.0.0.1:9101
OTTER_PUBLIC_URL=https://<portal host name>
# The edge's tunnel address (#22): its X-Forwarded-For is believed, and
# only it reads the edge's routes.
OTTER_TRUSTED_PROXIES=10.62.0.1
# Databases' hostnames: <infra name>.<this>, under the edge's wildcard.
OTTER_DB_DOMAIN=<database zone, e.g. db.example.com>
# The edge's routes (#103), polled by Traefik over the tunnel. PF lets
# the edge reach this port and nothing else does.
OTTER_EDGE_ADDR=10.64.1.20:8081
OTTER_LOG_LEVEL=info
