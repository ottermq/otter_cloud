#!/bin/sh
# otter-db-password: gives a platform DB role a new password, and writes it
# straight to the file of the process that logs in with it (the minimum
# profile, #58). Run as root on the node host.
#
#   otter-db-password [-d db-jail] [-j jail] <role> <file> <owner>
#
#   -d  the platform DB's jail (default otter-db)
#   -j  write <file> in that jail, e.g. otter-api; the default is the host
#
# The password is made here and travels only on stdin, through jexec: never
# as an argument, which JailDeck's audit log or ps would record, and never
# through a terminal. The server stores only its SCRAM verifier, and the
# session that sets it logs no statement. <file> is mode 0400, owned by
# <owner>, in a directory that must exist. Running it again replaces the
# password; the process using it needs a restart.
set -eu

dbjail=otter-db jail=
usage() {
	echo "usage: otter-db-password [-d db-jail] [-j jail] <role> <file> <owner>" >&2
	exit 2
}
while getopts d:j: opt; do
	case $opt in
	d) dbjail=$OPTARG ;;
	j) jail=$OPTARG ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# = 3 ] || usage
role=$1 file=$2 owner=$3
case $role in
*[!a-z0-9_]* | [!a-z_]*) echo "otter-db-password: $role is not a role name" >&2 && exit 2 ;;
esac
case $file in
/*) ;;
*) echo "otter-db-password: $file is not an absolute path" >&2 && exit 2 ;;
esac

pw=$(openssl rand -hex 24)

# The file first, beside its final name, so a failure leaves the old one.
# in_jail runs sh -c in the target jail, or on the host.
in_jail() {
	if [ -n "$jail" ]; then
		jexec "$jail" sh -c "$@"
	else
		sh -c "$@"
	fi
}
printf '%s\n' "$pw" | in_jail 'umask 077 && cat > "$1.new" && chown "$2" "$1.new" && chmod 0400 "$1.new"' \
	_ "$file" "$owner"

printf "SET log_statement = 'none';\nSET log_min_error_statement = 'panic';\nALTER ROLE %s PASSWORD '%s';\n" \
	"$role" "$pw" | jexec -U postgres "$dbjail" psql -X -q -v ON_ERROR_STOP=1 -d postgres

in_jail 'mv -f "$1.new" "$1"' _ "$file"
echo "otter-db-password: $role → ${jail:+$jail:}$file"
