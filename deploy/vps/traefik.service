# /etc/systemd/system/traefik.service: Traefik on the edge (#104).
[Unit]
Description=Traefik (Otter edge)
Documentation=https://github.com/ottermq/otter_cloud/tree/main/deploy/vps
Wants=network-online.target
After=network-online.target wg-quick@wg0.service

[Service]
User=traefik
Group=traefik
ExecStart=/usr/local/bin/traefik --configFile=/etc/traefik/traefik.yml
Restart=on-failure
RestartSec=5s

# The DNS token: read by systemd as root, handed to Traefik in a private
# directory; the file itself stays root-only.
LoadCredential=dns-token:/etc/traefik/dns-token
Environment=CF_DNS_API_TOKEN_FILE=%d/dns-token

# Ports below 1024 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

StateDirectory=traefik
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
