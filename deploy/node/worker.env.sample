# otter worker's settings on a node: paths and addresses, no secrets.
# Install as /usr/local/etc/otter/worker.env, mode 0640, root:otter.
# rc.d reads it as shell assignments, KEY=value, one per line: quote a
# value that holds &, ;, spaces or <>.

# The node's worker role, from `otter admin node add`, over the node's link
# to the platform DB.
OTTER_DATABASE_URL='postgres://otter_node_<name>@<platform-db>:5432/otter?sslmode=verify-full'
OTTER_DATABASE_PASSWORD_FILE=/usr/local/etc/otter/db-password

OTTER_JAILDECK_SOCKET=/var/run/jaildeck.sock
OTTER_JAILDECK_TOKEN_FILE=/usr/local/etc/otter/jaildeck-token
OTTER_CLUSTER_ADMIN_CERT_FILE=/usr/local/etc/otter/cluster-admin.crt
OTTER_CLUSTER_ADMIN_KEY_FILE=/usr/local/etc/otter/cluster-admin.key
OTTER_DUMP_DIR=/var/db/otter/dumps
OTTER_METRICS_ADDR=127.0.0.1:9102
OTTER_LOG_LEVEL=info

# Where the node's dumps are copied, sealed with age (#118): none (the
# default: they stay on the node, and each is recorded as skipped), fs or
# s3. The name is the target's in backup_records, the kind unless set; give
# a new one when moving to another target of the same kind.
OTTER_BACKUP_TARGET=none
#OTTER_BACKUP_TARGET_NAME=fs
# age recipients (public keys), one a line; the private key is never on the
# node.
#OTTER_BACKUP_RECIPIENTS_FILE=/usr/local/etc/otter/backup-recipients
# fs: a directory only the worker's user can enter (0700), such as a
# dataset another machine pulls.
#OTTER_BACKUP_FS_DIR=/var/db/otter/offsite
# s3: https://<endpoint>/<bucket>[/<prefix>], a prefix for the node, and a
# 0400 file of <access key id>:<secret access key>.
#OTTER_BACKUP_S3_URL=https://<endpoint>/<bucket>/<node>
#OTTER_BACKUP_S3_REGION=us-east-1
#OTTER_BACKUP_S3_CREDENTIALS_FILE=/usr/local/etc/otter/backup-s3
# The most the node's copies may add up to on the target; K, M or G.
#OTTER_BACKUP_MAX_BYTES=
