# otter worker's settings on a node: paths and addresses, no secrets.
# Install as /usr/local/etc/otter/worker.env, mode 0640, root:otter.
# rc.d reads it as shell assignments, KEY=value, one per line: quote a
# value that holds &, ;, spaces or <>.

# The node's worker role, from `otter admin node add`, over the node's link
# to the platform DB.
OTTER_DATABASE_URL='postgres://otter_node_<name>@<platform-db>:5432/otter?sslmode=verify-full'
OTTER_DATABASE_PASSWORD_FILE=/usr/local/etc/otter/db-password

OTTER_JAILDECK_SOCKET=/var/run/jaildeck.sock
OTTER_JAILDECK_TOKEN_FILE=/usr/local/etc/otter/jaildeck-token
OTTER_CLUSTER_ADMIN_CERT_FILE=/usr/local/etc/otter/cluster-admin.crt
OTTER_CLUSTER_ADMIN_KEY_FILE=/usr/local/etc/otter/cluster-admin.key
OTTER_DUMP_DIR=/var/db/otter/dumps
OTTER_METRICS_ADDR=127.0.0.1:9102
OTTER_LOG_LEVEL=info
